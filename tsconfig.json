{
  "compilerOptions": {
    "target": "ESNext",
    "useDefineForClassFields": true,
    "lib": ["DOM", "DOM.Iterable", "ESNext"],
    "types": [],
    "allowJs": false,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "paths": {
      "~/*": ["./components/*"],
      "@/*": ["./*"]
    },
    "allowImportingTsExtensions": true
  },
  "include": [
    "components/**/*.ts",
    "components/**/*.tsx",
    "scripts/**/*.ts",
    "test/**/*.ts",
    "test/**/*.tsx",
    "icons/**/*.ts",
    "icons/**/*.tsx",
    "preview/**/*.ts",
    "preview/**/*.tsx",
    "color-gen/**/*.ts",
    "color-gen/**/*.tsx",
    "*.ts"
  ]
}
